# Match the explorer API's platform operator Clerk instance.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/

# Server-only upstream bootstrap. Host routing and authorization policy come from MongoDB through this API.
EXPLORER_API_ORIGIN=http://127.0.0.1:3003


# Club host mappings live in the encrypted shared MongoDB configuration.
# The API returns only registered-host public metadata via GET /public/realm.
# Keep the referenced Clerk SDK secret values on this server; never prefix them with NEXT_PUBLIC_.
# EXPLORER_CLUB_MY_CLUB_CLERK_SECRET_KEY=sk_test_REPLACE
# CLERK_ENCRYPTION_KEY=REPLACE_WITH_32_RANDOM_BYTES_AS_HEX

# APP-26 operator checklist uses the existing API origin above. No setup signing
# or tenant encryption key belongs on this frontend. Provision Clerk/audience,
# MongoDB/runtime base, keys and SMTPS on the APIs, then verify before inviting.
# Reference metadata: workflow-local:<name>:{mongo,key} in local development,
# preview:<name>:{mongo,key} in preview, prod:<name>:{mongo,key} in production.
# Preview/prod/HSM activation requires compatible runtime/custody adapters.
